PORT=3000
NODE_ENV=development
# Obligatorio en producción: cadena aleatoria larga (p. ej. `openssl rand -hex 48`)
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800
BCRYPT_ROUNDS=12
# Orígenes web permitidos por CORS, separados por comas (vacío = todos).
# Con el frontend Angular en local: http://localhost:4200
ALLOWED_ORIGINS=
# Por defecto ./dev.db
DATABASE_URL=
# Por defecto ./uploads
UPLOADS_DIR=
AUTH_RATE_LIMIT=30
# Opcional: recorte del fondo con remove.bg (si falta, se usa el recorte local)
REMOVE_BG_API_KEY=
# Límites por IP: sesiones de invitado por hora e importaciones por 15 min
GUEST_RATE_LIMIT=20
IMPORT_RATE_LIMIT=40
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Prueba virtual con IA (foto de la persona + prendas -> foto generada)
# Proveedor: gemini | fashn | local. Si se deja vacío se usa el que tenga clave;
# sin claves se usa "local" (vista previa aproximada, sin IA).
TRYON_PROVIDER=
# Google Gemini (edición de imagen): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# FASHN (try-on especializado; no viste calzado): https://app.fashn.ai
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6
# Pruebas por usuario/IP cada 15 minutos (cada una cuesta en el proveedor)
TRYON_RATE_LIMIT=30
# Carpeta privada para fotos de la persona y resultados (no se publica en /media)
PRIVATE_DIR=
