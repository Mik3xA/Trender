PORT=3000
NODE_ENV=development
# Obligatorio en producción: cadena aleatoria larga (p. ej. `openssl rand -hex 48`)
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800
BCRYPT_ROUNDS=12
# Orígenes web permitidos por CORS, separados por comas (vacío = todos).
# Con el frontend Angular en local: http://localhost:4200
ALLOWED_ORIGINS=
# Por defecto ./dev.db
DATABASE_URL=
# Por defecto ./uploads
UPLOADS_DIR=
AUTH_RATE_LIMIT=30
# El escáner lee la página del producto (título, categoría, precio). false = solo la URL
SCAN_FETCH_PAGES=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
